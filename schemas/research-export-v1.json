{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocket-hunter.local/schemas/research-export-v1.json",
  "title": "Rocket Hunter Research Export v1",
  "description": "Normalized research observations exported from authoritative forecast and outcome JSONL ledgers. Outcome marks are not executable fills.",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "record_id",
    "forecast_id",
    "source_schema",
    "source_partition",
    "run_id",
    "market_key",
    "identity",
    "snapshot_utc",
    "forecast_utc",
    "observed_utc",
    "ingested_utc",
    "horizon_hours",
    "scanner_version",
    "pipeline_version",
    "core_runtime_version",
    "configuration_fingerprint",
    "local_configuration_json",
    "feature_snapshot_json",
    "source_record_json"
  ],
  "properties": {
    "schema_version": {"const": "crypto-prebreakout.research-export.v1"},
    "record_type": {"enum": ["forecast", "outcome"]},
    "record_id": {"type": "string", "minLength": 1},
    "forecast_id": {"type": "string", "minLength": 1},
    "source_schema": {"type": ["string", "null"]},
    "source_partition": {"type": "string"},
    "run_id": {"type": ["string", "null"]},
    "market_key": {"type": ["string", "null"]},
    "identity": {"type": ["string", "null"]},
    "chain": {"type": ["string", "null"]},
    "market_type": {"type": ["string", "null"]},
    "contract_address": {"type": ["string", "null"]},
    "token_mint": {"type": ["string", "null"]},
    "pool_address": {"type": ["string", "null"]},
    "pair_address": {"type": ["string", "null"]},
    "venue": {"type": ["string", "null"]},
    "base_asset": {"type": ["string", "null"]},
    "quote_asset": {"type": ["string", "null"]},
    "quote_symbol": {"type": ["string", "null"]},
    "pair_orientation": {"type": ["string", "null"]},
    "pair": {"type": ["string", "null"]},
    "asset": {"type": ["string", "null"]},
    "symbol": {"type": ["string", "null"]},
    "source": {"type": ["string", "null"]},
    "source_url": {"type": ["string", "null"]},
    "source_retrieved_utc": {"type": ["string", "null"]},
    "snapshot_utc": {"type": ["string", "null"]},
    "forecast_utc": {"type": ["string", "null"]},
    "observed_utc": {"type": ["string", "null"]},
    "ingested_utc": {"type": ["string", "null"]},
    "horizon_hours": {"type": ["integer", "null"]},
    "status": {"type": ["string", "null"]},
    "raw_score": {"type": ["number", "null"]},
    "price_usd": {"type": ["number", "null"]},
    "base_price_usd": {"type": ["number", "null"]},
    "observed_price_usd": {"type": ["number", "null"]},
    "mark_return_pct": {"type": ["number", "null"]},
    "scanner_version": {"type": ["string", "null"]},
    "pipeline_version": {"type": ["string", "null"]},
    "core_runtime_version": {"type": ["string", "null"]},
    "collector_overlay_version": {"type": ["string", "null"]},
    "configuration_fingerprint": {"type": ["string", "null"]},
    "local_configuration_json": {"type": ["string", "null"]},
    "identity_source": {"enum": ["record", "linked_forecast", "record_and_linked_forecast", "missing"]},
    "feature_snapshot_json": {"type": ["string", "null"]},
    "source_record_json": {"type": "string"}
  },
  "additionalProperties": false
}
